# TrailCurrent Tiercel -- build configuration.
#
# NEVER edit `sdkconfig` directly: it is generated and .gitignore'd, so an
# edit there is invisible to review. Everything goes here, and this file only
# SEEDS a new `sdkconfig` -- ESP-IDF does not re-apply it to an existing one.
# After changing anything below:
#
#     rm sdkconfig && idf.py build
#
# then confirm the key landed with `grep CONFIG_THE_KEY sdkconfig`.

CONFIG_IDF_TARGET="esp32s3"

# ---------------------------------------------------------------------------
# Memory: ESP32-S3R8 -- 8 MB OCTAL PSRAM in the package -- and 16 MB external
# flash. DIO, not QIO: it is what the factory image and Waveshare's demos
# boot with, and this unit's flash has not been proven in QIO.
# ---------------------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The S3's own USB-Serial/JTAG is what the USB-C port reaches in the S3
# orientation; the CH340 on the other orientation belongs to the ESP32.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 1 kHz tick: LVGL animation and the 3 ms knob poll both want it.
CONFIG_FREERTOS_HZ=1000

# Tmr Svc is shared with the Wi-Fi retry timer and the setup AP's DHCP
# server; Capstan overflowed the 2 KB default the moment setup mode started.
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# ---------------------------------------------------------------------------
# TLS. Headwaters' broker is TLS-only on 8883 with a self-signed certificate.
# mbedTLS record buffers come from PSRAM -- internal RAM is spoken for by the
# LVGL draw buffers, Wi-Fi and the I2S DMA, and an allocation failure inside
# TLS (-0x7F00) reads as a broker fault when nothing reached the network.
# ---------------------------------------------------------------------------
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
CONFIG_MQTT_TASK_STACK_SIZE=6144

# headwaters.local / peregrine.local resolve through lwIP's mDNS queries.
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y

# ---------------------------------------------------------------------------
# LVGL 9. Every MONTSERRAT_<n> the .eez-project references must be enabled
# here, or the build fails on an undeclared lv_font_montserrat_<n>. The
# product type and icons are custom fonts embedded in the project and exported
# as ui_font_*; Montserrat is only the bring-up screen's and LVGL's default.
# ---------------------------------------------------------------------------
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# lv_malloc() from the ESP heap rather than LVGL's fixed 64 KB pool. EEZ's
# export builds every screen at boot, which does not fit in 64 KB, and LVGL's
# out-of-memory handler is an infinite loop that presents as a watchdog reset.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
